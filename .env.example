# Copy to .env and fill in. Only OPENROUTER_API_KEY is needed for AI
# extraction; everything else has working defaults. GMAIL_* files live
# next to this file (see README for how to get credentials.json).

# --- OpenRouter (strictly required for AI extraction) ---
# Get a key at https://openrouter.ai/keys (sign up, then Create Key).
OPENROUTER_API_KEY=
# Model used for extraction (must support strict structured output):
OPENROUTER_MODEL=meta/muse-spark-1.3-contributor
# Leave this unless you self-host a gateway:
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Excel workbook (optional) ---
# Defaults to "Daily Working Report.xlsx" in the project folder.
# EXCEL_PATH=/path/to/Daily Working Report.xlsx

# --- Gmail (required for full sync) ---
# OAuth Desktop-client JSON downloaded from Google Cloud Console.
# GMAIL_CREDENTIALS_FILE=credentials.json
# Created automatically on first browser consent; auto-refreshes after that.
# GMAIL_TOKEN_FILE=token.json
# Gmail metadata search page size (all result pages are checked).
# GMAIL_MAX_THREADS=20

# --- Private pipeline cache (optional) ---
# PDFs, native text and raw AI evidence; ignored by Git.
# DAILY_REPORT_CACHE_DIR=/private/path/daily-report-cache
